{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "AllowReset": false
  },
  "Auth": {
    "LoginAttemptLimit": {
      "PermitLimit": 5,
      "Window": "00:01:00"
    }
  }
}
